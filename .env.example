# Copy this file to .env and replace every placeholder before running locally.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-another-random-secret-at-least-32-characters

POSTGRES_DB=gempa_dbscan_dev
POSTGRES_USER=user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://user@localhost:5432/gempa_dbscan_dev
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=var/uploads
ARTIFACT_DIR=var/artifacts
MAX_UPLOAD_MB=50

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

BMKG_TIMEOUT_SECONDS=8
BMKG_CACHE_SECONDS=60
SILHOUETTE_MAX_SAMPLE=10000
RANDOM_STATE=42
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
